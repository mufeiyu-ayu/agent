{
  "name": "agent",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "^24.11.0",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "dev": "pnpm dev:apps",
    "dev:api": "pnpm --filter @agent/api dev",
    "dev:admin": "pnpm --filter @agent/admin dev",
    "dev:web": "pnpm --filter @agent/web dev",
    "dev:apps": "node scripts/dev-apps.mjs",
    "test:dev-apps": "node --test scripts/dev-apps.test.mjs",
    "build:admin": "pnpm --filter @agent/admin build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "typecheck": "pnpm typecheck:workspaces",
    "typecheck:apps": "pnpm --recursive --filter './apps/*' typecheck",
    "typecheck:workspaces": "pnpm --recursive --filter './apps/*' --filter './packages/*' typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^24.19.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
