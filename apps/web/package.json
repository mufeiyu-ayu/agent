{
  "name": "@agent/web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @agent/contracts build",
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "prebuild": "pnpm --filter @agent/contracts build",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest run --root ../.. --project web"
  },
  "dependencies": {
    "@agent/contracts": "workspace:*",
    "@iconify/vue": "^5.0.3",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "markdown-it": "^14.3.2",
    "markdown-it-cjk-friendly": "^3.0.0",
    "reka-ui": "~2.9.10",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.11"
  }
}
