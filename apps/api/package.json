{
  "name": "@agent/api",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --workspace-root prisma:generate && pnpm --filter @agent/contracts build && tsc",
    "dev": "node scripts/dev-watch.mjs",
    "predev:watch": "pnpm --workspace-root prisma:generate && pnpm --filter @agent/contracts build && tsc",
    "dev:watch": "node scripts/dev-watch.mjs",
    "prebuild": "pnpm --workspace-root prisma:generate && pnpm --filter @agent/contracts build",
    "build": "tsc",
    "start": "node dist/main.js",
    "test:agent-recorder": "tsx --test src/agent-runtime/agent-run-recorder.service.test.ts",
    "test:context": "tsx --test src/agent-runtime/deepseek-v4-token-estimator.test.ts src/agent-runtime/initial-context-selection.test.ts src/agent-runtime/sampling-context-planner.test.ts",
    "test:grounding": "pnpm --filter @agent/contracts build && tsx --test src/tools/core/tool-evidence.test.ts src/agent-runtime/grounding/run-evidence-registry.test.ts src/agent-runtime/grounding/grounded-answer.contract.test.ts src/agent-runtime/grounding/grounded-answer.validator.test.ts src/agent-runtime/grounding/validated-answer-replay.test.ts src/agent-runtime/grounding/message-grounding.projector.test.ts src/agent-runtime/grounding/grounded-answer.finalizer.test.ts src/agent-runtime/grounding/grounded-answer.runtime.test.ts src/agent-runtime/grounding/grounded-answer.smoke.cli.test.ts",
    "test:grounding-db": "pnpm --filter @agent/contracts build && node --import tsx --env-file-if-exists=../../.env --test src/agent-runtime/grounding/grounded-answer.db.test.ts",
    "smoke:grounded-answer": "pnpm --filter @agent/contracts build && node --import tsx --env-file-if-exists=../../.env src/agent-runtime/grounding/grounded-answer.smoke.cli.ts",
    "test:article-indexing": "node --import tsx --test src/embeddings/embedding-provider.test.ts src/embeddings/gemini-embedding-sdk-boundary.test.ts src/embeddings/embedding-smoke.cli.test.ts src/article-indexing/article-chunking.test.ts src/article-indexing/article-indexer.test.ts src/article-indexing/article-indexing.cli.test.ts",
    "test:article-indexing-db": "node --import tsx --env-file-if-exists=../../.env --test src/article-indexing/article-indexing.db.test.ts",
    "smoke:embedding": "node --import tsx --env-file-if-exists=../../.env src/embeddings/embedding-smoke.cli.ts",
    "index:articles": "node --import tsx --env-file-if-exists=../../.env src/article-indexing/article-indexing.cli.ts",
    "index:articles:integration": "node --import tsx --env-file-if-exists=../../.env src/article-indexing/article-indexing.cli.ts --database-scope=integration",
    "test:retrieval": "tsx --test src/retrieval/article-retrieval.test.ts src/retrieval/prisma-article-retriever.test.ts src/retrieval/retrieval-evaluation.test.ts src/retrieval/postgres-article-retrieval.repository.test.ts src/retrieval/vector-hybrid-article-retriever.test.ts src/retrieval/hybrid-article-retrieval.runtime.test.ts src/retrieval/evaluation/article-retrieval-quality-v2.test.ts",
    "test:retrieval-db": "node --import tsx --env-file-if-exists=../../.env --test src/retrieval/retrieval.db.test.ts src/tools/retrieval/retrieve-article-context.db.test.ts",
    "smoke:retrieval-tool": "node --import tsx --env-file-if-exists=../../.env src/tools/retrieval/retrieve-article-context.smoke.cli.ts",
    "eval:retrieval-baseline": "tsx src/retrieval/retrieval-baseline.cli.ts",
    "eval:retrieval-quality": "node --import tsx --env-file-if-exists=../../.env src/retrieval/evaluation/article-retrieval-quality-v2.cli.ts",
    "test:admin-runs": "pnpm build && node --test dist/admin-runs/admin-runs.controller.test.js dist/admin-runs/admin-runs.service.test.js dist/admin-runs/admin-retrieval-inspector.test.js",
    "test:db-reliability": "tsx --env-file-if-exists=../../.env --test src/prisma/prisma.service.reliability.test.ts",
    "test:model-stream": "tsx --test src/llm/clients/openai-compatible-stream.adapter.test.ts src/llm/clients/openai-compatible-raw-capture.test.ts src/agent-runtime/agent-runtime.service.test.ts src/agent-runtime/model-sampling-decision.test.ts src/agent-runtime/model-io-debug-capture.test.ts",
    "test:llm-config": "tsx --test src/llm/model-profiles.test.ts src/llm/llm-runtime-config.test.ts src/llm/llm.module.test.ts src/llm/clients/openai-compatible.client.test.ts",
    "test:seo-service": "pnpm --filter @agent/contracts build && tsx --test src/seo/seo.service.test.ts src/seo/dto/seo-chat.dto.test.ts src/seo/prompts/seo-agent.prompt.test.ts",
    "test:tool-loop": "tsx --test src/agent-runtime/agent-runtime.service.test.ts src/agent-runtime/agent-runtime.policy.test.ts",
    "test:tools": "tsx --test src/tools/*.test.ts src/tools/**/*.test.ts",
    "pretypecheck": "pnpm --workspace-root prisma:generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix"
  },
  "dependencies": {
    "@agent/contracts": "workspace:*",
    "@google/genai": "^2.17.1",
    "@huggingface/tokenizers": "0.1.3",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "js-tiktoken": "^1.0.21",
    "openai": "^6.45.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
