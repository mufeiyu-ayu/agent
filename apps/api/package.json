{
  "name": "@agent/api",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --workspace-root prisma:generate && pnpm --filter @agent/contracts build && pnpm --filter @agent/ai build && tsc",
    "dev": "node scripts/dev-watch.mjs",
    "prebuild": "pnpm --workspace-root prisma:generate && pnpm --filter @agent/contracts build && pnpm --filter @agent/ai build",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run --root ../.. --project api",
    "pretypecheck": "pnpm --workspace-root prisma:generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix"
  },
  "dependencies": {
    "@agent/ai": "workspace:*",
    "@agent/contracts": "workspace:*",
    "@mozilla/readability": "^0.6.0",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "ali-oss": "6.23.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "e2b": "2.31.0",
    "es-module-lexer": "2.3.2",
    "linkedom": "^0.18.13",
    "openai": "^6.49.0",
    "pg": "^8.23.0",
    "postcss": "8.5.28",
    "proxy-agent": "5.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/ali-oss": "6.23.3",
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
