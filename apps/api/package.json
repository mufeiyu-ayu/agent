{
  "name": "@agent/api",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --workspace-root prisma:generate && pnpm --filter @agent/contracts build && pnpm --filter @agent/ai build && tsc",
    "dev": "node scripts/dev-watch.mjs",
    "prebuild": "pnpm --workspace-root prisma:generate && pnpm --filter @agent/contracts build && pnpm --filter @agent/ai build",
    "build": "tsc",
    "start": "node dist/main.js",
    "test:agent-recorder": "tsx --test src/agent-runtime/lifecycle/agent-run-recorder.service.test.ts src/agent-runtime/lifecycle/run-cancellation.test.ts",
    "test:context": "tsx --test src/agent-runtime/context/deepseek-v4-token-estimator.test.ts src/agent-runtime/context/sampling-context-planner.test.ts",
    "test:runtime-db": "pnpm --filter @agent/contracts build && pnpm --filter @agent/ai build && node --import tsx --env-file-if-exists=../../.env --test src/agent-runtime/agent-runtime.db.test.ts",
    "test:admin": "pnpm build && node --test dist/admin-runs/admin-runs.controller.test.js dist/admin-runs/admin-runs.service.test.js dist/admin-conversations/admin-conversations.service.test.js dist/admin-overview/admin-overview.service.test.js",
    "test:db-reliability": "tsx --env-file-if-exists=../../.env --test src/prisma/prisma.service.reliability.test.ts",
    "test:model-stream": "tsx --test src/agent-runtime/agent-runtime.service.test.ts src/agent-runtime/sampling/model-sampling-decision.test.ts src/agent-runtime/sampling/model-io-debug-capture.test.ts",
    "test:llm-config": "pnpm --filter @agent/contracts build && tsx --test src/llm/llm.module.test.ts src/llm/llm.service.test.ts src/admin-llm/admin-llm.service.test.ts",
    "test:chat-service": "pnpm --filter @agent/contracts build && pnpm --filter @agent/ai build && tsx --test src/chat/chat.service.test.ts src/chat/dto/chat.dto.test.ts src/chat/prompts/agent.prompt.test.ts",
    "test:tool-loop": "tsx --test src/agent-runtime/configuration/agent-runtime.policy.test.ts",
    "test:tools": "tsx --test $(find src/tools -name '*.test.ts' ! -name '*.db.test.ts')",
    "pretypecheck": "pnpm --workspace-root prisma:generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix"
  },
  "dependencies": {
    "@agent/ai": "workspace:*",
    "@agent/contracts": "workspace:*",
    "@huggingface/tokenizers": "0.1.3",
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "openai": "^6.45.0",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
