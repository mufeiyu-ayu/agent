# ─── LLM 配置 ──────────────────────────────
# 模型接入（服务商地址、API Key、模型名与能力）全部在管理台「模型」页配置并存数据库，
# 这里只留一把加密数据库里 Provider API Key 的主密钥。
#
# 后端 dev 脚本会从项目根目录 .env 读取这些变量。
# 使用时请复制本文件为项目根目录 .env，不要把真实密钥提交到仓库。

# 主密钥（必填，至少 32 个字符；留空时 API 启动失败）。生成：openssl rand -hex 32
# 换掉它之后数据库里已存的 Provider 密钥全部无法解密，需要在管理台重新填写。
AGENT_SECRET_KEY=

# 出站代理（可选）：管理台勾选「使用代理」的服务商经它访问，其余服务商直连；只认 http(s)://，
# Clash 的 mixed-port 同时支持 HTTP；API 放进 Docker 时主机写 host.docker.internal。不再读取 HTTPS_PROXY / NO_PROXY。
# OUTBOUND_PROXY_URL=http://127.0.0.1:7890

# ─── API 端口 ──────────────────────────────
# API 监听端口（可选；缺省为 3000）。API 只监听 127.0.0.1，局域网访问走前台 / 管理台的 Vite 代理。
# 显式设置时 dev 脚本（scripts/dev-apps.mjs）直接用它；不设置时从 3000 起找第一个空闲端口。
# PORT=3000

# ─── Agent Runtime 配置 ─────────────────────
# 单次 Run 一次查询最多读取的可靠历史候选（50-1000；缺省为 1000）
# 最终进入模型的条数仍由 Context Budget 在首轮采样前裁剪决定。
AGENT_HISTORY_CANDIDATE_HARD_LIMIT=1000

# Agent Loop 最大模型采样轮数（十进制正安全整数；缺省为 10）
AGENT_MAX_SAMPLING_ROUNDS=10

# Agent Loop 最大工具调用次数（十进制非负安全整数；缺省为 8）
# 按 call 计数，同轮多个 Tool Call 各算一次；与 AGENT_MAX_SAMPLING_ROUNDS 相互独立，0 表示不向模型提供工具。
AGENT_MAX_TOOL_CALLS=8

# 整个 Agent Run 的执行时限（毫秒，1-2147483647；缺省为 600000）
# 模型流首个响应头的超时是 packages/ai 内的 600000ms 常量（重试时每次尝试各自计时），
# 流正文阶段只受本变量约束。
AGENT_RUN_DEADLINE_MS=600000

# Tool timeout 由各 Tool Definition 声明。上面四个整数变量：空字符串、非整数、
# NaN、Infinity 或超出各自范围的值会使应用启动失败，不会被静默截断或回退。

# debug 开关：捕获每轮模型采样的 provider 原始请求体和组装后的原始响应 JSON，
# 落到 model_sampling AgentStep 并在后台请求检查器展示（1/true 开启；缺省关闭）。
# 仅用于学习 / 调试观测；单侧序列化超过约 200KB 时截断为前缀预览。
AGENT_DEBUG_CAPTURE_MODEL_IO=false

# ─── 数据库配置（阶段 2 必填）──────────────────
# PostgreSQL 连接字符串。
# 本地示例：postgresql://postgres:postgres@127.0.0.1:5432/agent?schema=public（compose 只把 5432 发布到 127.0.0.1）
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/agent?schema=public

# 通用隔离测试库（compose 的 postgres-test，profile integration）：DB 测试专用，
# 不得指向上面的正式 / 开发数据库。启动：docker compose --profile integration up -d postgres-test
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/agent_integration
