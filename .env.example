# ─── LLM 配置（必填）─────────────────────────
# DeepSeek / OpenAI-compatible Chat Completions API
#
# 后端 dev 脚本会从项目根目录 .env 读取这些变量。
# 使用时请复制本文件为项目根目录 .env，不要把真实 API Key 提交到仓库。

# API 密钥（必填）
# DeepSeek: https://platform.deepseek.com/api_keys
LLM_API_KEY=sk-your-api-key-here

# API Base URL（必填，需包含 /v1，不要以 / 结尾也可以，代码会做兼容）
# DeepSeek: https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名（必填）
# 当前仅支持 deepseek-v4-flash（名单见 packages/ai/src/deepseek.ts）
LLM_MODEL=deepseek-v4-flash

# ─── Gemini Embedding 配置（仅显式 smoke / indexing / retrieval 使用）──
# 普通 API 启动不会解析这些变量，也不会回退到上面的 LLM_* 配置。

# Google AI Studio Gemini API Key（执行显式 Embedding runtime 时必填）
GEMINI_API_KEY=your-gemini-api-key-here

# 单次最多输入数（1-375；缺省为 64）
EMBEDDING_BATCH_SIZE=64

# 单次请求超时（毫秒，1-2147483647；缺省为 60000）
EMBEDDING_REQUEST_TIMEOUT_MS=60000

# 项目级重试次数（0-2；缺省为 2）；Gemini SDK 隐式重试固定关闭。
EMBEDDING_MAX_RETRIES=2

# retrieve_article_context smoke 使用的查询（可选；缺省为“SEO 标题应该怎么写”）
# 仅 pnpm --filter @agent/api smoke:retrieval-tool 读取，普通启动不解析。
RETRIEVAL_TOOL_SMOKE_QUERY=SEO 标题应该怎么写

# Grounded Answer smoke 使用的两条查询（均可选，缺省见下方注释）
# 仅 pnpm --filter @agent/api smoke:grounded-answer 读取，普通启动不解析，
# 也不会因为缺失而导致 API 启动失败。
# 两条 query 都必须指向站内知识库真实覆盖 / 真实不覆盖的内容：
# 通用方法论问题会被 Agent 直接回答，不会建立 Grounding Session。
# answered 路径：期望站内文章能够支撑回答
GROUNDED_ANSWER_SMOKE_ANSWERABLE_QUERY=只用语义检索一次站内文章，回答 Wuthering Waves 的 soft pity 是什么
# insufficient 路径：期望检索到语义近邻但不足以确认
GROUNDED_ANSWER_SMOKE_UNANSWERABLE_QUERY=只用语义检索一次站内文章，回答《原神》2019 年封闭内测的服务器维护公告写了什么

# SEO Chat 单次 Run 一次查询最多读取的可靠历史候选（50-1000；缺省为 1000）
# 最终进入模型的条数仍由 Context Budget 在首轮采样前裁剪决定。
SEO_CHAT_HISTORY_CANDIDATE_HARD_LIMIT=1000

# Agent Loop 最大模型采样轮数（十进制正安全整数；缺省为 10）
AGENT_MAX_SAMPLING_ROUNDS=10

# Agent Loop 最大工具调用次数（十进制非负安全整数；缺省为 8）
# 按 call 计数，同轮多个 Tool Call 各算一次；与 AGENT_MAX_SAMPLING_ROUNDS 相互独立，0 表示不向模型提供工具。
AGENT_MAX_TOOL_CALLS=8

# 整个 Agent Run 的执行时限（毫秒，1-2147483647；缺省为 600000）
# 模型流首个响应头的超时是 packages/ai 内的 600000ms 常量（重试时每次尝试各自计时），
# 流正文阶段只受本变量约束。
AGENT_RUN_DEADLINE_MS=600000

# Tool timeout 由各 Tool Definition 声明。上面四个整数变量：空字符串、非整数、
# NaN、Infinity 或超出各自范围的值会使应用启动失败，不会被静默截断或回退。

# debug 开关：捕获每轮模型采样的 provider 原始请求体和组装后的原始响应 JSON，
# 落到 model_sampling AgentStep 并在后台请求检查器展示（1/true 开启；缺省关闭）。
# 仅用于学习 / 调试观测；单侧序列化超过约 200KB 时截断为前缀预览。
AGENT_DEBUG_CAPTURE_MODEL_IO=false

# ─── 数据库配置（阶段 2 必填）──────────────────
# PostgreSQL 连接字符串。
# 本地示例：postgresql://postgres:postgres@localhost:5432/agent_ai_seo?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_ai_seo?schema=public

# Article indexing DB integration 专用连接；不得指向上面的正式/开发数据库。
ARTICLE_INDEX_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/agent_ai_seo_integration
