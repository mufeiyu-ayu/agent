# ─── LLM 配置（必填）─────────────────────────
# DeepSeek / OpenAI-compatible Chat Completions API
#
# 后端 dev 脚本会从项目根目录 .env 读取这些变量。
# 使用时请复制本文件为项目根目录 .env，不要把真实 API Key 提交到仓库。

# API 密钥（必填）
# DeepSeek: https://platform.deepseek.com/api_keys
LLM_API_KEY=sk-your-api-key-here

# API Base URL（必填，需包含 /v1，不要以 / 结尾也可以，代码会做兼容）
# DeepSeek: https://api.deepseek.com/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名（必填）
# DeepSeek 常用模型：deepseek-v4-flash、deepseek-v4-pro
LLM_MODEL=deepseek-v4-flash

# 普通 Chat 请求超时（毫秒，十进制正整数；缺省为 60000）
LLM_CHAT_REQUEST_TIMEOUT_MS=60000

# Stream 请求超时（毫秒，十进制正整数；缺省为 600000）
LLM_STREAM_TIMEOUT_MS=600000

# 应用默认最大输出 Token（十进制正整数；缺省为 65536）
LLM_DEFAULT_MAX_OUTPUT_TOKENS=65536

# 应用输出硬上限（十进制正整数；缺省为 131072）
# 必须满足：默认输出 <= 应用硬上限 <= 当前模型 Provider 输出上限。
LLM_APPLICATION_MAX_OUTPUT_TOKENS=131072

# ─── Gemini Embedding 配置（仅显式 smoke / indexing / retrieval 使用）──
# 普通 API 启动不会解析这些变量，也不会回退到上面的 LLM_* 配置。

# Google AI Studio Gemini API Key（执行显式 Embedding runtime 时必填）
GEMINI_API_KEY=your-gemini-api-key-here

# 单次最多输入数（1-375；缺省为 64）
EMBEDDING_BATCH_SIZE=64

# 单次请求超时（毫秒，1-2147483647；缺省为 60000）
EMBEDDING_REQUEST_TIMEOUT_MS=60000

# 项目级重试次数（0-2；缺省为 2）；Gemini SDK 隐式重试固定关闭。
EMBEDDING_MAX_RETRIES=2

# retrieve_article_context smoke 使用的查询（可选；缺省为“SEO 标题应该怎么写”）
# 仅 pnpm --filter @agent/api smoke:retrieval-tool 读取，普通启动不解析。
RETRIEVAL_TOOL_SMOKE_QUERY=SEO 标题应该怎么写

# SEO Chat 历史候选单批读取数量（50-1000；缺省为 50）
# 仅控制 DB keyset query 批大小，不限制最终模型 History 条数；不得大于 hard limit。
SEO_CHAT_HISTORY_CANDIDATE_BATCH_SIZE=50

# SEO Chat 单次 Run 最多扫描的可靠历史候选（50-1000；缺省为 1000）
# 最终选入数量仍由 Context Budget 决定；batch size 不得大于 hard limit。
SEO_CHAT_HISTORY_CANDIDATE_HARD_LIMIT=1000

# Agent Loop 最大模型采样轮数（十进制正安全整数；缺省为 3）
AGENT_MAX_SAMPLING_ROUNDS=3

# Agent Loop 最大工具调用次数（十进制非负安全整数；缺省为 2）
# 必须小于 AGENT_MAX_SAMPLING_ROUNDS，为最终回答保留一轮 sampling。
AGENT_MAX_TOOL_CALLS=2

# 整个 Agent Run 的执行时限（毫秒，1-2147483647；缺省为 600000）
# 与 LLM_STREAM_TIMEOUT_MS 的单次模型流超时分别治理。
AGENT_RUN_DEADLINE_MS=600000

# metadata 请求固定使用 10000ms；Tool timeout 继续由各 Tool Definition 声明。
# 除 AGENT_MAX_TOOL_CALLS 允许 0 外，空字符串、0、负数、浮点数、指数、NaN、
# Infinity 或超限值会使应用启动失败，
# 不会被静默截断或回退。

# ─── 数据库配置（阶段 2 必填）──────────────────
# PostgreSQL 连接字符串。
# 本地示例：postgresql://postgres:postgres@localhost:5432/agent_ai_seo?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent_ai_seo?schema=public

# Article indexing DB integration 专用连接；不得指向上面的正式/开发数据库。
ARTICLE_INDEX_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/agent_ai_seo_integration
