// Prisma 数据模型入口。
// 阶段 2 定义了 Conversation / Message；阶段 4 增加了 AgentRun / AgentStep。
//
// 核心概念（初学重点，先理解这四层再看字段）：
//   Conversation 长期会话（一个聊天窗口，长期存在）
//   Message      用户可见消息（页面上的气泡）
//   AgentRun     一次用户输入触发的运行（按一次发送 = 一个 run）
//   AgentStep    一次 run 内部的系统执行步骤（加载历史 / 调模型 / 流式回复）
//                注意：AgentStep 是「系统执行过程」，不是模型真实的思考链。

generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  // 数据库方言的唯一权威来源。这里是 PostgreSQL，
  // DATABASE_URL 也必须是 postgresql:// 开头。
  provider = "postgresql"
}

// 消息发送方。只区分用户与助手；system 提示词不落库为 Message。
enum MessageRole {
  USER
  ASSISTANT
}

// 单条「用户可见消息」的生命周期状态。
// 关注点：这条气泡当前该怎么渲染。
enum MessageStatus {
  PENDING // 已创建但还没产出内容（占位）
  STREAMING // 正在流式接收内容，前端逐字追加
  COMPLETED // 正常结束，内容完整
  FAILED // 出错结束，content 里通常是兜底错误文案
  ABORTED // 用户主动停止，保留已生成的部分内容
}

// 一次 AgentRun 的整体状态。
// 与 MessageStatus 的区别：这里关注「整次运行成没成」，
// 所以没有 PENDING / STREAMING，用 RUNNING 表示进行中。
enum AgentRunStatus {
  RUNNING // 进行中（创建 run 时的默认值）
  COMPLETED // 本次运行成功结束
  FAILED // 本次运行因异常结束
  ABORTED // 本次运行被用户中断
}

// 单个 AgentStep 的状态。
// PENDING 保留用于兼容历史数据；当前 Runtime 在真实开始时直接创建 RUNNING step。
enum AgentStepStatus {
  PENDING // 历史占位状态；新 Runtime 不预创建未知步骤
  RUNNING // 正在执行
  COMPLETED // 执行成功
  FAILED // 执行失败（errorMessage 记录原因）
  ABORTED // 因整次 run 被中断而未完成
}

// ─── 账号与登录（Issue #195）────────────────────────
// 两种角色：管理员进管理台、管理账号；成员只用前台。
enum UserRole {
  ADMIN
  MEMBER
}

model User {
  id                 String    @id @default(cuid())
  // 登录标识，存小写；Google 首次登录时按它匹配已有账号。
  email              String    @unique
  // scrypt 自描述串：算法、参数、salt、哈希都在里面，换参数不用迁移。Google 注册的账号没有密码。
  passwordHash       String?
  // Google 账号的稳定 ID（id_token 的 sub）；绑定后按它找人，邮箱变了也不改绑。
  googleSub          String?   @unique
  // 昵称与头像地址来自 Google 的 name / picture，每次 Google 登录时更新；密码账号为空。
  name               String?
  avatarUrl          String?
  role               UserRole  @default(MEMBER)
  // 对外是三态（启用 / 待审核 / 停用，停用优先），库里用两个布尔：迁移只加不删，回退到旧版本仍能运行。
  // 陌生 Google 账号登录后待审核；管理员通过 → 两者皆假，拒绝 → 停用。
  disabled           Boolean   @default(false)
  pendingApproval    Boolean   @default(false)
  // 管理员建号或重置密码后为真，登录后必须先改密码。
  mustChangePassword Boolean   @default(true)
  // 连续失败次数与锁定截止时间存库，重启不丢。
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  sessions           Session[]
  conversations      Conversation[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// 服务端 Session：Cookie 里是随机 token，库里只存它的 SHA-256。
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Conversation {
  id        String     @id @default(cuid())
  title     String
  // 归属用户。可空：存量会话迁移时还没有用户，由 create-admin 脚本回填；新会话一律写入。
  userId      String?
  user        User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages    Message[]
  agentRuns   AgentRun[]
  compactions ConversationCompaction[]
  workspace   ConversationWorkspace?
  artifacts   WorkspaceArtifact[]
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  // 会话列表按「最近活跃」排序，给 updatedAt 加索引。
  @@index([updatedAt])
  // 前台只列自己的会话。
  @@index([userId, updatedAt])
}

// 文件放私有 OSS；这里只保存最新已确认版本、运行所有权与维护状态。
model ConversationWorkspace {
  conversationId String @id
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId String
  revision Int @default(0)
  files Json @default("[]")
  webProject Boolean @default(false)
  artifactId String?
  ownerRunId String?
  leaseExpiresAt DateTime?
  sandboxId String?
  state String @default("idle")
  lastOperation String?
  lastError String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([state, leaseExpiresAt])
  @@index([userId])
}

// 不可变成功构建清单；源码继续使用工作区 revision，旧预览固定到自己的构建。
model WorkspaceArtifact {
  id String @id
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId String
  runId String
  sourceRevision Int
  command String
  files Json
  createdAt DateTime
  retiredAt DateTime?
  previewExpiresAt DateTime?

  @@index([conversationId, createdAt])
}

// 清理目标不随会话级联删除；Bucket 身份固定，失败/重启由相同入口重试。
model WorkspaceGcTarget {
  conversationId String @id
  userId String
  bucket String
  deletedAt DateTime?
  deletingKey String?
  deleteId String?
  deleteState String?
  pending Boolean @default(true)
  generation Int @default(1)
  updatedAt DateTime @updatedAt

  @@index([pending])
}

// OSS 与 DB 不能原子提交；活跃/未知上传阻止回收，不能仅按租约过期判定安全。
model WorkspaceUpload {
  id String @id
  conversationId String
  runId String
  bucket String
  keys String[] @default([])
  state String @default("active")
  startedAt DateTime @default(now())
  endedAt DateTime?

  @@index([conversationId, state])
}

// 平台观察到的沙箱生命周期；不设会话 / Run 外键，删除会话不抹掉使用统计。
model SandboxExecution {
  id String @id @default(cuid())
  userId String
  conversationId String
  runId String
  title String
  template String
  apiHost String
  sandboxId String? @unique
  state String @default("creating")
  requestedAt DateTime @default(now())
  startedAt DateTime?
  releasedAt DateTime?
  expiresAt DateTime?
  durationMs BigInt?
  checkedAt DateTime?
  updatedAt DateTime @updatedAt

  @@index([requestedAt])
  @@index([state, requestedAt])
  @@index([userId, requestedAt])
  @@index([runId])
  @@index([conversationId, requestedAt])
}

model Message {
  id                    String     @id @default(cuid())
  conversationId        String
  // 消息属于某个会话；会话删除时其下消息一并删除（级联）。
  conversation          Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role                  MessageRole
  content               String
  status                MessageStatus @default(COMPLETED)
  // 同一条 Message 可能被 AgentRun 从两个角度引用：
  //   作为「用户输入」-> userAgentRuns
  //   作为「助手回复」-> assistantAgentRuns
  // 因为指向同一张表有两条外键，Prisma 无法自动区分，
  // 必须用具名关系 @relation("名字") 在两侧一一对应。
  userAgentRuns         AgentRun[] @relation("AgentRunUserMessage")
  assistantAgentRuns    AgentRun[] @relation("AgentRunAssistantMessage")
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  // 「取某会话最近消息并按时间排序」是高频查询，用复合索引覆盖。
  @@index([conversationId, createdAt])
}

model AgentRun {
  id                 String         @id @default(cuid())
  conversationId     String
  // 所属会话，会话删除则级联删除本次运行记录。
  conversation       Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // 触发本次运行的用户消息。必填（没有用户输入就没有这次 run）。
  // 用户消息删除时级联删除该 run。关系名要与 Message 侧完全一致。
  userMessageId      String
  userMessage        Message        @relation("AgentRunUserMessage", fields: [userMessageId], references: [id], onDelete: Cascade)

  // 本次运行产出的助手消息。可空（String?）：
  // run 先创建、assistant 消息稍后才建，创建 run 那一刻它还不存在。
  // 删除策略用 SetNull 而非 Cascade：即使助手消息被删，
  // 「这次运行发生过」的事实仍要保留，只把引用置空。
  assistantMessageId String?
  assistantMessage   Message?       @relation("AgentRunAssistantMessage", fields: [assistantMessageId], references: [id], onDelete: SetNull)

  status             AgentRunStatus @default(RUNNING)
  // 失败类别：进入 FAILED / ABORTED 时与终态同事务写入，成功与旧 Run 为空。
  // 与 AgentStep.type 同理用字符串而非枚举，取值由 contracts 的 AGENT_RUN_ERROR_CODES 约束。
  errorCode          String?
  startedAt          DateTime       @default(now())
  // 结束时间：运行中为空，进入终态（完成/失败/中断）时写入。
  endedAt            DateTime?
  steps              AgentStep[]
  compactions        ConversationCompaction[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([conversationId])
  @@index([userMessageId])
  @@index([assistantMessageId])
  // 便于按状态筛选，例如排查残留在 RUNNING 的运行。
  @@index([status])
  @@index([createdAt])
}

model AgentStep {
  id           String          @id @default(cuid())
  runId        String
  // 步骤隶属于某次运行，run 删除则级联删除其所有步骤。
  run          AgentRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  // 同一 Run 内的稳定执行顺序，从 1 开始单调递增。
  sequence     Int

  // 步骤类型用字符串而非枚举：步骤种类会随功能演进不断新增
  // （未来加 Tool Calling 等），用 String 避免频繁改 schema/迁移。
  // 取值由后端常量 AGENT_STEP_TYPES 统一约束。
  type         String
  // 给人看的步骤标题，如「加载会话历史」。
  title        String
  status       AgentStepStatus @default(PENDING)

  // 步骤的输入 / 输出快照，用 Json 存半结构化数据（不同步骤字段不同）。
  // 例如 loadConversationHistory 不写 input、output 记 messageCount。
  input        Json?
  output       Json?
  // 仅失败步骤填写，记录错误摘要。
  errorMessage String?

  // 步骤真正开始 / 结束的时间；与行创建时间区分。
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([runId])
  @@unique([runId, sequence])
  // 按「某次 run 的某类步骤」查询，用复合索引。
  @@index([runId, type])
  @@index([status])
  @@index([createdAt])
}

// 历史压缩（Issue #220）：把已结束的之前问答写成摘要，每条记录自成完整，只存成功的。
// 历史 = 最新一条记录的摘要 + 不在 coveredGroupIds 里的问答原文；原消息与 Step 一条不删。
model ConversationCompaction {
  id                String       @id @default(cuid())
  conversationId    String
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // 触发它的 Run（问答中途压缩或问答结束后预压）；Run 删了记录照样有效。
  runId             String?
  run               AgentRun?    @relation(fields: [runId], references: [id], onDelete: SetNull)
  // threshold（调模型前超触发线）/ after_run（问答结束后预压）/ overflow（服务商报超长）。
  reason            String
  summary           String
  // 累计被摘要覆盖的问答组，组键 = 组内第一条消息的 id（通常是用户问题）。
  coveredGroupIds   String[]
  // 以「问题 + 回答全文」保留的边界组；它的完整内容已进摘要，不在 coveredGroupIds 里。
  answerOnlyGroupId String?
  // 读取历史快照的时刻：最新记录按 readAt、createdAt、id 倒序取第一条；分块写的几条 readAt 相同。
  readAt            DateTime
  // 触发这次压缩的估算 token。
  tokensBefore      Int
  // 这一条那次摘要调用的用量，形状同采样 Step 的 output.usage。
  usage             Json?
  // 写摘要用的模型行 id；不建外键：模型行会随服务商删除。
  modelId           String
  createdAt         DateTime     @default(now())

  @@index([conversationId, readAt])
}

// 阶段 5 Tool Calling 的只读演示数据。
// sourceId 保留来源系统文章 ID，便于固定数据重复导入时幂等更新。
model Article {
  id             String   @id @default(cuid())
  sourceId       Int      @unique
  slug           String   @unique
  languageCode   String
  title          String
  content        String
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([title])
}

// ─── LLM 配置（Issue #142）────────────────────────────
// Provider 是一把 key + 一个 baseUrl；同一个中转站按 key 分组就是多个 Provider。
// 密钥用 AGENT_SECRET_KEY 派生的密钥 AES-256-GCM 加密后存放，只回显尾四位。
model LlmProvider {
  id              String     @id @default(cuid())
  // 服务商就是模型家族：deepseek / openai / grok / gemini / claude / other，决定管理台标识与导入预设，
  // 不参与请求拼接（一把中转站 key 可能跨家族）。取值由 contracts 的 LLM_PROVIDER_FAMILIES 约束。
  family          String
  // 给人看的备注，例如「公司中转站」「官方」；不参与任何逻辑。
  note            String
  baseUrl         String
  apiKeyEncrypted String
  apiKeyLast4     String
  enabled         Boolean    @default(true)
  // 是否经 .env 的 OUTBOUND_PROXY_URL 访问（国外服务商勾选，国内直连）；代理地址只在 env，不入库。
  useProxy        Boolean    @default(false)
  models          LlmModel[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// 模型能力字段由 Admin 人工维护：`/models` 接口给不出 contextWindow / maxOutput / 是否思考。
model LlmModel {
  id                  String      @id @default(cuid())
  providerId          String
  provider            LlmProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  // 发给 Provider 的模型名；前台展示用 displayName。
  wireName            String
  displayName         String
  contextWindowTokens Int
  // 单次请求最多发给模型的输入 token（Issue #216）：管理台保存时校验 1 ≤ 它 ≤ 窗口 − 输出上限 − 安全余量，运行时直接用作输入预算。
  maxInputTokens      Int
  maxOutputTokens     Int
  // 默认发给服务商的 reasoning_effort；null 不发。取值按家族由 contracts 的 LLM_FAMILY_CAPABILITIES 约束。
  reasoningEffort     String?
  // 前台模型下拉只列 visible 为真的行；拉取导入默认为假。
  visible             Boolean     @default(false)
  // 全局唯一的默认模型；前台不传 model 时使用。
  isDefault           Boolean     @default(false)
  sortOrder           Int         @default(0)
  // 管理台「测试」的上次结果：一条最短对话是否通、失败原因、时间；没测过为 null。
  lastProbeOk         Boolean?
  lastProbeError      String?
  lastProbedAt        DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([providerId, wireName])
  @@index([visible, sortOrder])
}

// ─── 运行配置（Issue #216）──────────────────────────────
// 只有一行（id 固定为 1，migration 插入、CHECK 约束兜底；时限下限也有 CHECK）：单次最长时间、压缩保留最近 Tokens、调试开关与联网搜索的 Serper Key。
// 每次问答开始时读一次作为快照，进行中的问答不受后台修改影响；没有环境变量兜底，行缺失就明确报错。
model RuntimeConfig {
  id                         Int      @id @default(1)
  // 单次问答正常执行阶段的最长时间，单位毫秒；管理台按秒显示。一次问答不限轮数与工具调用次数，只由它兜底。
  runDeadlineMs              Int
  // 是否抓取模型原始请求 / 响应 JSON 写进采样 Step。
  debugCaptureModelIo        Boolean
  // 上下文压缩时保留最近原文的 token 数（#220）：实际取 min(它, 模型单次输入上限的 1/4)；CHECK 限 1,000～200,000。
  compactionKeepRecentTokens Int      @default(20000)
  // Serper Key 与服务商 Key 同样用 AGENT_SECRET_KEY 派生的密钥加密，只回显尾四位；没配为 null。
  serperApiKeyEncrypted      String?
  serperApiKeyLast4          String?
  updatedAt                  DateTime @updatedAt
}
